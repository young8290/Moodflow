<?xml version="1.0" encoding="UTF-8"?>
<!-- Moodflow 输入法的包文件类型。装到 /usr/share/mime/packages/moodflow.xml，shared-mime-info
     的 dpkg 触发器会重建 MIME 数据库。两种包各一个类型（同 Windows 各一个 ProgId）：
     文件管理器里要分得出手上是方案还是主题。图标在 hicolor/*/mimetypes/（gen-mime-icons.py）。
     设置程序在没装 deb 的场合会把本文件原样（include_str!）写到用户目录，改这里两边一起变。 -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-moodflow-package">
    <comment>Moodflow schema package</comment>
    <comment xml:lang="zh_CN">Moodflow 输入法方案包</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.wpkg"/>
    <icon name="application-x-moodflow-package"/>
  </mime-type>
  <mime-type type="application/x-moodflow-theme">
    <comment>Moodflow theme package</comment>
    <comment xml:lang="zh_CN">Moodflow 输入法主题包</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.wtheme"/>
    <icon name="application-x-moodflow-theme"/>
  </mime-type>
</mime-info>
